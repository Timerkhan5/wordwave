@using wordwave.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Админ-панель";
    var tasks = ViewBag.Tasks as List<wordwave.Models.Task> ?? new List<wordwave.Models.Task>();
    var materials = ViewBag.Materials as List<wordwave.Models.Material> ?? new List<wordwave.Models.Material>();
    var mlRecommendations = ViewBag.MlRecommendations as List<AdminMlRecommendationDto> ?? new List<AdminMlRecommendationDto>();
    var mlChartData = Enumerable.Range(1, 5)
        .Select(level => new
        {
            difficulty = level,
            count = mlRecommendations.Count(r => r.TaskId.HasValue && r.Difficulty == level)
        })
        .ToList();
    var averageSuccess = mlRecommendations.Any(r => r.TaskId.HasValue)
        ? Math.Round(mlRecommendations.Where(r => r.TaskId.HasValue).Average(r => r.SuccessProbability) * 100)
        : 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <style>
        .admin-section { margin-bottom: 48px; }
        .admin-title { font-size: 32px; font-weight: 700; margin-bottom: 18px; }
        .admin-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
        .admin-table th, .admin-table td { border: 1px solid #e0e0e0; padding: 8px 12px; }
        .admin-table th { background: #f5f5f5; }
        .admin-actions { display: flex; gap: 8px; }
        .admin-add-btn { margin-bottom: 12px; }
        .admin-ai-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
        .admin-ai-row input { padding: 8px 10px; border: 1px solid #ddd; border-radius: 8px; }
        .admin-ai-row input[type="number"] { width: 120px; }
        .admin-ai-status { margin-top: 10px; font-size: 14px; }
        .admin-ml-panel {
            background: #fff;
            border: 1px solid #e8e2fb;
            border-radius: 10px;
            color: #232e52;
            padding: 22px;
        }
        .admin-ml-summary {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            margin-bottom: 20px;
        }
        .admin-ml-metric {
            background: #f7f7fa;
            border-radius: 8px;
            padding: 14px 16px;
        }
        .admin-ml-metric__label {
            color: #6f7592;
            font-size: 13px;
            margin-bottom: 4px;
        }
        .admin-ml-metric__value {
            color: #232e52;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.1;
        }
        .admin-ml-layout {
            display: grid;
            gap: 22px;
            grid-template-columns: minmax(280px, 420px) 1fr;
            align-items: start;
        }
        .admin-ml-chart-wrap {
            background: #f7f7fa;
            border-radius: 8px;
            padding: 16px;
        }
        #ml-chart {
            display: block;
            width: 100%;
            height: 260px;
        }
        .admin-ml-note {
            color: #6f7592;
            font-size: 13px;
            margin-top: 10px;
        }
        .admin-ml-table-wrap {
            overflow-x: auto;
        }
        .admin-ml-probability {
            background: #ece8fa;
            border-radius: 999px;
            height: 10px;
            min-width: 120px;
            overflow: hidden;
        }
        .admin-ml-probability__bar {
            background: linear-gradient(90deg, #32c7a5, #8d5cf6);
            height: 100%;
        }
        .admin-ml-empty {
            color: #6f7592;
            padding: 16px 0;
        }
        @@media (max-width: 1100px) {
            .admin-ml-summary,
            .admin-ml-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
@await Html.PartialAsync("_AdminNav")
<main>
    <section class="admin-section">
        <div class="admin-title">AI генератор заданий</div>
        <div class="admin-ai-row">
            <input id="ai-topic" placeholder="Тема (topic)" />
            <input id="ai-count" type="number" min="1" max="20" value="5" />
            <input id="ai-difficulty" type="number" min="1" max="5" value="2" />
            <button class="btn btn--primary" id="ai-generate-btn" type="button">Сгенерировать и сохранить</button>
            <button class="btn btn--outline" id="ai-test-btn" type="button">Тест (без сохранения)</button>
        </div>
        <div class="admin-ai-status" id="ai-status" style="color:#666;"></div>
    </section>

    <section class="admin-section">
        <div class="admin-title">ML рекомендации</div>
        <div class="admin-ml-panel">
            <div class="admin-ml-summary">
                <div class="admin-ml-metric">
                    <div class="admin-ml-metric__label">Пользователей в выборке</div>
                    <div class="admin-ml-metric__value">@mlRecommendations.Count</div>
                </div>
                <div class="admin-ml-metric">
                    <div class="admin-ml-metric__label">Средний шанс успеха</div>
                    <div class="admin-ml-metric__value">@averageSuccess%</div>
                </div>
                <div class="admin-ml-metric">
                    <div class="admin-ml-metric__label">Модель</div>
                    <div class="admin-ml-metric__value" style="font-size:18px;">LogReg</div>
                </div>
            </div>

            <div class="admin-ml-layout">
                <div class="admin-ml-chart-wrap">
                    <canvas id="ml-chart" aria-label="Распределение ML рекомендаций по сложности"></canvas>
                    <div class="admin-ml-note">График показывает, задания какой сложности модель рекомендует пользователям прямо сейчас.</div>
                </div>

                <div class="admin-ml-table-wrap">
                    @if (mlRecommendations.Count == 0)
                    {
                        <div class="admin-ml-empty">Пока нет пользователей для ML-рекомендаций.</div>
                    }
                    else
                    {
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Пользователь</th>
                                    <th>Рекомендация</th>
                                    <th>Сложность</th>
                                    <th>Шанс</th>
                                    <th>Причина</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in mlRecommendations)
                            {
                                var percent = Math.Round(item.SuccessProbability * 100);
                                <tr>
                                    <td>@item.UserName</td>
                                    <td>
                                        @if (item.TaskId.HasValue)
                                        {
                                            <a asp-controller="Task" asp-action="Details" asp-route-id="@item.TaskId">Задание @item.TaskId</a>
                                        }
                                        else
                                        {
                                            <span>Нет задания</span>
                                        }
                                    </td>
                                    <td>@(item.TaskId.HasValue ? item.Difficulty.ToString() : "-")</td>
                                    <td>
                                        @if (item.TaskId.HasValue)
                                        {
                                            <div style="display:flex;align-items:center;gap:10px;">
                                                <div class="admin-ml-probability">
                                                    <div class="admin-ml-probability__bar" style="width:@percent%;"></div>
                                                </div>
                                                <span>@percent%</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>@item.Reason</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="admin-section">
        <div class="admin-title">Задания</div>
        <a class="btn btn--primary admin-add-btn" asp-controller="Task" asp-action="Create">Добавить задание</a>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Вопрос</th>
                    <th>Сложность</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in tasks)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Question</td>
                    <td>@t.Difficulty</td>
                    <td class="admin-actions">
                        <a class="btn btn-warning btn-sm" asp-controller="Task" asp-action="Edit" asp-route-id="@t.Id">Редактировать</a>
                        <form asp-controller="Task" asp-action="Delete" asp-route-id="@t.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить задание?');">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>
    <section class="admin-section">
        <div class="admin-title">Материалы</div>
        <a class="btn btn--primary admin-add-btn" asp-controller="Materials" asp-action="Create">Добавить материал</a>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in materials)
            {
                <tr>
                    <td>@m.Id</td>
                    <td>@m.Name</td>
                    <td>@m.Author</td>
                    <td class="admin-actions">
                        <a class="btn btn-warning btn-sm" asp-controller="Materials" asp-action="Edit" asp-route-id="@m.Id">Редактировать</a>
                        <form asp-controller="Materials" asp-action="Delete" asp-route-id="@m.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить материал?');">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>
    <section class="admin-section">
        <div class="admin-title">Экзамен</div>
        <a class="btn btn--primary admin-add-btn" asp-controller="Task" asp-action="Create" asp-route-isExam="true">Добавить экзаменационное задание</a>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Вопрос</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in tasks.Where(x => x.IsExam))
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Question</td>
                    <td class="admin-actions">
                        <a class="btn btn-warning btn-sm" asp-controller="Task" asp-action="Edit" asp-route-id="@t.Id">Редактировать</a>
                        <form asp-controller="Task" asp-action="Delete" asp-route-id="@t.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить задание?');">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>
</main>

@section Scripts {
<script>
  const mlChartData = @Html.Raw(JsonSerializer.Serialize(mlChartData));

  function drawMlChart() {
    const canvas = document.getElementById('ml-chart');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const ratio = window.devicePixelRatio || 1;
    const width = canvas.clientWidth;
    const height = canvas.clientHeight;
    canvas.width = width * ratio;
    canvas.height = height * ratio;
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    ctx.clearRect(0, 0, width, height);

    const padding = { top: 22, right: 18, bottom: 42, left: 36 };
    const chartWidth = width - padding.left - padding.right;
    const chartHeight = height - padding.top - padding.bottom;
    const maxCount = Math.max(1, ...mlChartData.map(item => item.count));
    const colors = ['#8d5cf6', '#32c7a5', '#ffb84d', '#f50049', '#4c7dff'];
    const barGap = 14;
    const barWidth = Math.max(18, (chartWidth - barGap * (mlChartData.length - 1)) / mlChartData.length);

    ctx.strokeStyle = '#d9d8e8';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(padding.left, padding.top);
    ctx.lineTo(padding.left, height - padding.bottom);
    ctx.lineTo(width - padding.right, height - padding.bottom);
    ctx.stroke();

    ctx.fillStyle = '#6f7592';
    ctx.font = '12px Montserrat, Arial, sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText(String(maxCount), padding.left - 8, padding.top + 4);
    ctx.fillText('0', padding.left - 8, height - padding.bottom + 4);

    mlChartData.forEach((item, index) => {
      const x = padding.left + index * (barWidth + barGap);
      const barHeight = (item.count / maxCount) * chartHeight;
      const y = height - padding.bottom - barHeight;

      ctx.fillStyle = colors[index % colors.length];
      ctx.beginPath();
      ctx.roundRect(x, y, barWidth, barHeight || 2, 6);
      ctx.fill();

      ctx.fillStyle = '#232e52';
      ctx.font = '700 14px Montserrat, Arial, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(String(item.count), x + barWidth / 2, y - 8);

      ctx.fillStyle = '#6f7592';
      ctx.font = '12px Montserrat, Arial, sans-serif';
      ctx.fillText(`L${item.difficulty}`, x + barWidth / 2, height - padding.bottom + 24);
    });
  }

  drawMlChart();
  window.addEventListener('resize', drawMlChart);

  const topicEl = document.getElementById('ai-topic');
  const countEl = document.getElementById('ai-count');
  const difficultyEl = document.getElementById('ai-difficulty');
  const statusEl = document.getElementById('ai-status');
  const genBtn = document.getElementById('ai-generate-btn');
  const testBtn = document.getElementById('ai-test-btn');

  function setBusy(isBusy) {
    genBtn.disabled = isBusy;
    testBtn.disabled = isBusy;
    topicEl.disabled = isBusy;
    countEl.disabled = isBusy;
    difficultyEl.disabled = isBusy;
  }

  async function postJson(url, body) {
    const resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    let data = null;
    try { data = await resp.json(); } catch {}
    return { resp, data };
  }

  async function generateAndSave() {
    const topic = (topicEl.value || '').trim();
    const count = Number(countEl.value || 5);
    const difficulty = Number(difficultyEl.value || 2);

    if (!topic) {
      statusEl.style.color = '#f50049';
      statusEl.textContent = 'Введите тему (topic).';
      return;
    }

    setBusy(true);
    statusEl.style.color = '#666';
    statusEl.textContent = 'Генерация...';

    try {
      const { resp, data } = await postJson('/admin/api/ai/generate-and-save', { topic, count, difficulty });
      if (resp.ok) {
        statusEl.style.color = '#4caf50';
        statusEl.textContent = `OK: создано ${data.created}. IDs: ${(data.ids || []).join(', ')}`;
      } else if (resp.status === 401 || resp.status === 403) {
        statusEl.style.color = '#f50049';
        statusEl.textContent = 'Нет доступа. Нужно войти под admin.';
      } else {
        statusEl.style.color = '#f50049';
        const details = (data && (data.details || data.error)) ? ` ${data.details || data.error}` : '';
        statusEl.textContent = `Ошибка (${resp.status}):${details || ' неизвестно'}`;
      }
    } catch (e) {
      statusEl.style.color = '#f50049';
      statusEl.textContent = 'Ошибка сети при вызове AI.';
    } finally {
      setBusy(false);
    }
  }

  async function testGenerate() {
    const topic = (topicEl.value || '').trim();
    const count = Number(countEl.value || 5);
    const difficulty = Number(difficultyEl.value || 2);

    if (!topic) {
      statusEl.style.color = '#f50049';
      statusEl.textContent = 'Введите тему (topic).';
      return;
    }

    setBusy(true);
    statusEl.style.color = '#666';
    statusEl.textContent = 'Тестовая генерация...';

    try {
      const { resp, data } = await postJson('/admin/api/ai/test-generate', { topic, count, difficulty });
      if (resp.ok) {
        const tasks = Array.isArray(data) ? data : (data && data.tasks);
        const version = data && data.generatorVersion;
        statusEl.style.color = '#4caf50';
        statusEl.textContent = `OK (preview): получено ${Array.isArray(tasks) ? tasks.length : 0} заданий${version ? ` (gen ${version})` : ''}. См. console.`;
        console.log('AI preview tasks:', tasks, version ? `(generator ${version})` : '');
      } else if (resp.status === 401 || resp.status === 403) {
        statusEl.style.color = '#f50049';
        statusEl.textContent = 'Нет доступа. Нужно войти под admin.';
      } else {
        statusEl.style.color = '#f50049';
        const details = (data && (data.details || data.error)) ? ` ${data.details || data.error}` : '';
        statusEl.textContent = `Ошибка (${resp.status}):${details || ' неизвестно'}`;
      }
    } catch {
      statusEl.style.color = '#f50049';
      statusEl.textContent = 'Ошибка сети при вызове AI.';
    } finally {
      setBusy(false);
    }
  }

  genBtn.addEventListener('click', generateAndSave);
  testBtn.addEventListener('click', testGenerate);
</script>
}
